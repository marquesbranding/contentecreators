# Public application configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_placeholder

# Server-only database and Supabase configuration
APP_ENV=local
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=service_role_local_placeholder
# Hosted deployments also accept the Vercel/Supabase integration aliases:
# POSTGRES_URL, POSTGRES_URL_NON_POOLING, and SUPABASE_SECRET_KEY.

# Local-only comma/semicolon/newline-separated administrator allowlist.
# Every configured identity is synchronized with the development-only password
# documented in docs/operations/environments.md. Never set this in hosted stages.
LOCAL_ADMIN_EMAILS=admin@contentecreators.test

# Optional local Google OAuth. Keep the provider disabled until real local
# credentials and callback URLs are configured.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=local-google-client-id-placeholder
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=local-google-secret-placeholder

# Application email catcher / Marques Branding SMTP
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=local-user
SMTP_PASSWORD=local-password
SMTP_FROM_NAME=Contente Creators
SMTP_FROM_EMAIL=no-reply@contentecreators.test

# Signed operational endpoints
CRON_SECRET=replace-with-at-least-32-random-characters

# Beta privacy guard: changing this to true is intentionally invalid.
PUBLIC_SOCIAL_PROOF_ENABLED=false

# Public legal/support contact. The `.test` value is local-only and must be
# replaced by the client-approved address before hosted deployment.
SUPPORT_CONTACT_EMAIL=privacidade@contentecreators.test
