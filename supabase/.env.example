# Read by `npm run supabase:config:push` to resolve the env(...) placeholders
# in the [remotes.production] block of supabase/config.toml. Copy to
# supabase/.env and fill with the hosted Marques Branding SMTP values.
# Never commit supabase/.env.
#
# The SUPABASE_ prefix is required: the CLI lets ambient variables override
# this file, so reusing the application's SMTP_* names would let a shell that
# loaded .env.local publish the local mail catcher to production.
SUPABASE_SMTP_HOST=smtp.provedor.com
SUPABASE_SMTP_USER=usuario-smtp
SUPABASE_SMTP_PASSWORD=senha-ou-api-key
SUPABASE_SMTP_SENDER_EMAIL=contentecreators@marquesbranding.com
