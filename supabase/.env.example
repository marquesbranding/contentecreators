# Read by the Supabase CLI (supabase/.env) when `npm run supabase:config:push`
# resolves the env(...) placeholders in the [remotes.production] block.
# Copy to supabase/.env and fill with the hosted Marques Branding SMTP values
# taken from Vercel production. Never commit supabase/.env.
SMTP_HOST=smtp.provedor.com
SMTP_USER=usuario-smtp
SMTP_PASSWORD=senha-ou-api-key
SMTP_FROM_EMAIL=contentecreators@marquesbranding.com
